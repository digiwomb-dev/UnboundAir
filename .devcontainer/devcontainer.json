{
  "name": "UnboundAir",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "workspaceFolder": "/workspaces/UnboundAir",

  // Keep the Gradle cache across container rebuilds. Without this every
  // rebuild downloads the full dependency set again.
  "mounts": [
    "source=unboundair-gradle-cache,target=/home/ubuntu/.gradle,type=volume"
  ],

  // A named volume is created owned by root, which would shadow the
  // directory the Dockerfile prepared. Hand it back to the ubuntu user.
  "postCreateCommand": "sudo chown ubuntu:ubuntu /home/ubuntu/.gradle",

  // DC-01 acceptance criterion: both have to answer inside the container.
  "postAttachCommand": "java -version && jpegtran -version",

  "customizations": {
    "vscode": {
      "extensions": [
        "fwcd.kotlin",
        "vscjava.vscode-java-pack",
        "vscjava.vscode-gradle"
      ]
    }
  },

  "remoteUser": "ubuntu"
}
