---
/*
 * Adds the Content Security Policy. It lives here and not in the `head`
 * option of astro.config.mjs on purpose: the global `head` stays empty
 * (condition 2 in #229 — it is the hook Starlight's own docs use to load
 * analytics from a CDN), while per-page `head` frontmatter stays allowed
 * for tags that load nothing (e.g. `meta robots` for noindex in #234).
 */
import Default from '@astrojs/starlight/components/Head.astro';
---

<Default {...Astro.props} />
<!--
  Visitor-side complement to the build-time third-party gate (#233).
  Two honest limits: 'unsafe-inline' is unavoidable because Starlight sets
  the theme through an inline script; a <meta> CSP cannot carry
  frame-ancestors, and GitHub Pages allows no real HTTP headers.
-->
<meta
  http-equiv="Content-Security-Policy"
  content="default-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src 'none'"
/>
