{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "model": "lmstudio/qwen3-coder-30b",
  "small_model": "lmstudio/qwen3-4b",
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1"
      },
      "models": {
        "qwen3-coder-30b": {
          "name": "Qwen3-Coder 30B (local)",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 16384,
            "output": 8192
          }
        },
        "qwen3-4b": {
          "name": "Qwen3 4B (local)",
          "limit": {
            "context": 8192,
            "output": 4096
          }
        },
        "devstral-small": {
          "name": "Devstral Small (local second opinion)",
          "tool_call": true,
          "limit": {
            "context": 16384,
            "output": 8192
          }
        },
        "gpt-oss-20b": {
          "name": "GPT-OSS 20B (local third opinion)",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 16384,
            "output": 8192
          }
        }
      }
    }
  }
}
